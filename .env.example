# gateway (default) uses one Vercel AI Gateway key for many models.
# openai calls OpenAI directly with OPENAI_API_KEY.
AI_PROVIDER=gateway

# Gateway ids look like "provider/model". Direct OpenAI ids do not.
# Examples: openai/gpt-5.4-mini, anthropic/claude-sonnet-5.5, gpt-5.4-mini
AI_MODEL=openai/gpt-5.4-mini

AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
